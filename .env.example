# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Where settings are stored (SQLite file, created on first start).
# Docker Compose ignores this and keeps the database in its volume.
DATABASE_PATH=./data/bot.sqlite

# debug | info | warn | error
LOG_LEVEL=info

# ── Music ────────────────────────────────────────────────────────────────
# Music is played through Lavalink. Docker Compose runs it next to the bot;
# make up a long random password here, and the two use it to talk to each
# other. Leave it empty to run the bot without music (not with Compose).
LAVALINK_PASSWORD=

# Where Lavalink is, when you run it yourself. Docker Compose sets these.
# LAVALINK_HOST=localhost
# LAVALINK_PORT=2333
# LAVALINK_SECURE=false

# Tokens of extra bot accounts that play music, separated by commas. Each one
# lets one more voice channel have music at the same time. The bot above plays
# too, after these are all busy.
MUSIC_BOT_TOKENS=

# For Spotify links and searches: an app from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Market for Spotify availability and artists' top tracks.
SPOTIFY_COUNTRY_CODE=US
